# ============================================================================
# OnDeal Intelligence — variables d'environnement
# Copier ce fichier en `.env` (dev) ou configurer ces valeurs dans votre
# plateforme de déploiement (production). Ne JAMAIS committer .env.
# ============================================================================

# --- Base de données ---------------------------------------------------
# Dev par défaut : SQLite local (aucune configuration requise).
# Production recommandée : PostgreSQL (ex. Vercel Postgres, Supabase, Neon).
DATABASE_URL="file:./dev.db"

# --- Authentification ----------------------------------------------------
# Secret utilisé pour signer les sessions (JWT). Générer avec :
#   openssl rand -base64 32
AUTH_SECRET="changeme-generate-a-real-secret"

# --- Chiffrement des tokens d'intégration (Shopify/Judge.me) -------------
# Clé 32 octets en base64 utilisée pour chiffrer les tokens stockés en base.
# Générer avec : openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="changeme-generate-a-real-32-byte-key"

# --- Intégration Shopify (par boutique connectée) -------------------------
# Ces valeurs sont saisies par boutique depuis Settings > Intégrations,
# PAS ici. Cette section documente le format attendu pour référence :
#   SHOPIFY_STORE_DOMAIN=my-store.myshopify.com
#   SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (scopes Admin API requis : read_products, read_inventory, read_orders)

# --- Intégration Judge.me (par boutique connectée) ------------------------
# Également saisi par boutique depuis Settings > Intégrations :
#   JUDGEME_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   JUDGEME_SHOP_DOMAIN=my-store.myshopify.com

# --- Installation Shopify en un clic (OAuth) — commercialisation ----------
# Requis UNIQUEMENT pour /api/shopify/install et /api/shopify/callback (le
# parcours "jeton manuel" ci-dessus reste disponible sans ces variables,
# pour vos boutiques pilotes). Valeurs à récupérer dans le Partner Dashboard
# Shopify (dev.shopify.com) > votre app > Client credentials.
# SHOPIFY_API_KEY n'est PAS secret (identifiant public de l'app). Seul
# SHOPIFY_API_SECRET doit être traité comme un secret (jamais exposé côté
# client, jamais dans les logs — utilisé pour vérifier les signatures HMAC
# des callbacks OAuth et des webhooks).
SHOPIFY_API_KEY="changeme"
SHOPIFY_API_SECRET="changeme"
# URLs à déclarer dans le Partner Dashboard (Configuration > URLs) :
#   App URL              = ${APP_URL}
#   Allowed redirection   = ${APP_URL}/api/shopify/callback
# Webhooks obligatoires enregistrés automatiquement à l'installation (voir
# src/lib/integrations/shopify-oauth.ts) : aucune configuration manuelle de
# webhook nécessaire dans le Partner Dashboard.

# --- Synchronisation planifiée (Vercel Cron) -------------------------------
# Requis pour /api/cron/sync (toutes boutiques non-démo, toutes les 6h — voir
# vercel.json > crons). Vercel injecte automatiquement cette valeur en
# en-tête `Authorization: Bearer <secret>` sur les invocations planifiées :
# générer avec `openssl rand -base64 32` et définir la MÊME valeur dans les
# variables d'environnement du projet Vercel (Production). Sans cette
# variable, la route refuse toute requête (401), y compris celles de Vercel.
CRON_SECRET="changeme-generate-a-real-secret"

# --- Assistant IA (optionnel) ---------------------------------------------
# Si absent, l'Assistant IA fonctionne en mode déterministe (moteur de
# requêtes basé sur des règles, sans appel à un modèle externe) : il répond
# toujours à partir des données réelles calculées, jamais inventées.
# Si présent, les réponses en langage naturel sont formulées par le modèle,
# mais STRICTEMENT à partir des données réelles déjà calculées (le modèle
# ne reçoit jamais un accès direct à la base — voir lib/intelligence/assistant.ts).
ANTHROPIC_API_KEY=""

# --- Application -----------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
