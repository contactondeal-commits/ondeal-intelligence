// ============================================================================
// OnDeal Intelligence — schéma de données
// Hiérarchie multi-tenant stricte : User → Organization → Store → Données.
// Toute requête applicative doit filtrer par storeId (voir src/lib/db.ts et
// src/lib/auth.ts::requireStoreAccess). Aucune donnée n'est partagée entre
// organisations.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite en développement (zero-config). En production, définir
  // DATABASE_URL vers PostgreSQL et changer provider = "postgresql"
  // (voir docs/DEPLOYMENT.md — schéma 100% compatible, aucun type SQLite-only utilisé).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITÉ & SAAS
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("users")
}

enum Role {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      Plan     @default(STARTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // FACTURATION SHOPIFY (commercialisation) — null tant qu'aucun abonnement
  // Shopify Billing n'a été créé. billingProvider distingue une organisation
  // facturée via Shopify d'une organisation gérée manuellement (compte
  // interne/pilote), pour ne jamais confondre les deux. Le statut brut
  // Shopify (ACTIVE/PENDING/CANCELLED/EXPIRED/FROZEN/DECLINED) est conservé
  // tel quel — Organization.plan n'est mis à jour QUE quand le webhook
  // app_subscriptions/update confirme un statut ACTIVE.
  billingProvider              String? // "shopify" | "stripe" | null
  shopifySubscriptionId        String? // GID AppSubscription Shopify
  shopifySubscriptionStatus    String? // statut brut renvoyé par Shopify
  shopifySubscriptionUpdatedAt DateTime?

  // FACTURATION STRIPE (lot 11, 05/09/2026) — chemin de paiement
  // indépendant de Shopify, pour que TOUT marchand ou personne intéressée
  // puisse s'abonner par carte bancaire, quelle que soit sa plateforme
  // catalogue (WooCommerce/PrestaShop/aucune) ou même un compte Shopify
  // connecté (le marchand choisit alors son moyen de paiement). Même
  // discipline que Shopify ci-dessus : `plan` n'est mis à jour QUE quand le
  // webhook Stripe confirme un statut actif — jamais anticipé à la création
  // de la session de paiement.
  stripeCustomerId            String? // id client Stripe (cus_...), créé au premier essai de paiement
  stripeSubscriptionId        String? // id abonnement Stripe (sub_...)
  stripeSubscriptionStatus    String? // statut brut Stripe (active/trialing/past_due/canceled/...)
  stripeSubscriptionUpdatedAt DateTime?

  memberships Membership[]
  stores      Store[]

  @@map("organizations")
}

enum Plan {
  STARTER
  PRO
  BUSINESS
  AGENCY
}

// Table de plans : limites par plan (nombre de boutiques, de produits
// synchronisés, d'utilisateurs). Consultée par src/lib/plan-limits.ts.
// Le paiement n'est pas implémenté dans cette V1 (voir SAAS.md) mais les
// limites sont déjà appliquées pour que l'ajout d'un fournisseur de
// paiement n'exige pas de refonte du modèle.
model PlanLimit {
  plan        Plan @id
  maxStores   Int
  maxProducts Int
  maxUsers    Int

  @@map("plan_limits")
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(VIEWER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// BOUTIQUE & INTÉGRATIONS
// ---------------------------------------------------------------------------

model Store {
  id                     String   @id @default(cuid())
  organizationId         String
  name                   String
  domain                 String? // ex: my-store.myshopify.com
  isDemo                 Boolean  @default(false) // Mode Démo — jamais mélangé aux vraies données
  currency               String   @default("EUR")
  // HYPOTHÈSES boutique (jamais des données Shopify) : transport moyen par
  // commande et taux de frais de paiement, utilisés en repli quand aucune
  // CostAssumption produit n'existe. Explicitement étiquetées "estimées".
  defaultShippingCost    Float?
  defaultPaymentFeesRate Float? // ex. 0.029 pour 2.9%
  // Scopes Admin API réellement accordés lors de l'installation OAuth
  // (ex. "read_products,read_inventory,read_orders"), tels que renvoyés par
  // Shopify — jamais supposés. null = boutique connectée par jeton manuel
  // (parcours pré-OAuth) ou non connectée.
  shopifyGrantedScope    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  integrations              Integration[]
  products                  Product[]
  reviews                   Review[]
  testReviews               TestReview[]
  scoreSnapshots            ScoreSnapshot[]
  recommendations           Recommendation[]
  actions                   ActionItem[]
  auditLogs                 AuditLog[]
  syncRuns                  SyncRun[]
  costAssumptions           CostAssumption[]
  orders                    Order[]
  marginSnapshots           MarginSnapshot[]
  analyticsSnapshots        AnalyticsSnapshot[]
  analyticsChannelSnapshots AnalyticsChannelSnapshot[]
  jobs                      Job[]
  storefrontMissions        StorefrontMission[] // PHASE 5 — AI Lab Ultimate, mission Supervisor ciblant réellement cette boutique (Store Data/Shopify/GA4/Judge.me/CJ)

  @@index([organizationId])
  @@map("stores")
}

// WOOCOMMERCE/PRESTASHOP (04/09/2026) — connecteurs catalogue alternatifs à
// Shopify. Un Store n'a JAMAIS plus d'une intégration catalogue CONNECTED en
// même temps parmi SHOPIFY/WOOCOMMERCE/PRESTASHOP (vérifié par
// /api/integrations/connect, pas par une contrainte de base — mélanger deux
// catalogues dans un même Store doublerait le catalogue sans avertissement).
// JUDGEME reste indépendant de la source catalogue.
enum IntegrationProvider {
  SHOPIFY
  JUDGEME
  WOOCOMMERCE
  PRESTASHOP
  // Fournisseur (dropshipping) — indépendant du catalogue (05/09/2026) :
  // lecture seule du stock réel CJ, jamais compté comme intégration
  // catalogue (voir CATALOG_PROVIDERS, api/integrations/connect/route.ts).
  CJDROPSHIPPING
  // Trafic/acquisition (05/09/2026) — OAuth Google, lecture seule (Data API
  // + Admin API), indépendant du catalogue comme CJDROPSHIPPING ci-dessus.
  // Voir src/lib/integrations/google-analytics.ts.
  GOOGLE_ANALYTICS
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

// Les identifiants sont chiffrés (AES-256-GCM, voir src/lib/crypto.ts) avant
// stockage — jamais en clair, jamais dans les logs. Aucune valeur par défaut
// fictive n'est écrite ici : tant qu'un connecteur n'a pas d'enregistrement
// CONNECTED, l'application affiche "Non connecté".
model Integration {
  id                   String              @id @default(cuid())
  storeId              String
  provider             IntegrationProvider
  status               IntegrationStatus   @default(NOT_CONNECTED)
  encryptedCredentials String? // JSON chiffré { domain, token, ... }
  lastSyncedAt         DateTime?
  lastError            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([storeId])
  @@map("integrations")
}

model SyncRun {
  id           String              @id @default(cuid())
  storeId      String
  provider     IntegrationProvider
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  status       String // "running" | "success" | "partial" | "error"
  itemsFetched Int                 @default(0)
  itemsStored  Int                 @default(0)
  errorCount   Int                 @default(0)
  errorSample  String? // JSON, échantillon d'erreurs pour diagnostic
  statsJson    String? // JSON : comptes détaillés (produits, variantes, unitCost, commandes, lignes, troncatures, durées par étape)
  triggeredBy  String // "manual" | "scheduled" | "bulk_import"

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, provider])
  @@map("sync_runs")
}

// ---------------------------------------------------------------------------
// CATALOGUE
// ---------------------------------------------------------------------------

model Product {
  id               String    @id @default(cuid())
  storeId          String
  shopifyProductId String // GID Shopify d'origine
  handle           String
  title            String
  status           String // active | draft | archived (statut Shopify réel)
  productType      String?
  vendor           String?
  imageUrl         String?
  createdAtShopify DateTime?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants        Variant[]
  reviews         Review[]
  scoreSnapshots  ScoreSnapshot[]
  recommendations Recommendation[]
  costAssumption  CostAssumption?
  salesSnapshots  SalesSnapshot[]
  orderLines      OrderLine[]

  @@unique([storeId, shopifyProductId])
  @@index([storeId])
  @@index([storeId, status])
  @@map("products")
}

model Variant {
  id                String   @id @default(cuid())
  productId         String
  shopifyVariantId  String
  title             String
  sku               String?
  price             Float? // prix de vente actuel (devise du store), null si non défini
  compareAtPrice    Float?
  inventoryQuantity Int? // stock boutique, null = donnée non disponible
  supplierStock     Int? // stock fournisseur si connu (ex. CJ/DSers), null sinon — JAMAIS écrit par la sync Shopify (démo uniquement)
  // Coût unitaire RÉEL tel que renseigné dans Shopify (inventoryItem.unitCost),
  // dans la devise indiquée. null = non renseigné côté Shopify. Distinct de
  // CostAssumption (hypothèses saisies à la main dans OnDeal, par produit) :
  // la source Shopify est identifiable comme telle, jamais confondue.
  unitCost          Float?
  unitCostCurrency  String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]

  @@unique([productId, shopifyVariantId])
  @@index([productId])
  @@map("variants")
}

// ---------------------------------------------------------------------------
// COMMANDES — entités réelles conservées (pas seulement agrégées) pour
// pouvoir distinguer commandes / unités / chiffre d'affaires, exclure les
// commandes annulées, et rattacher chaque ligne à sa variante. Montants
// stockés tels que retournés par Shopify (devise de la boutique) — aucun
// montant "net" n'est dérivé tant que les remboursements ne sont pas
// intégrés au calcul (voir totalRefunded : conservé, pas soustrait).
// ---------------------------------------------------------------------------

model Order {
  id               String    @id @default(cuid())
  storeId          String
  shopifyOrderId   String
  name             String? // ex. "#1001"
  createdAtShopify DateTime
  cancelledAt      DateTime?
  financialStatus  String? // displayFinancialStatus Shopify (PAID, REFUNDED, PARTIALLY_REFUNDED, ...)
  currencyCode     String?
  totalPrice       Float? // currentTotalPriceSet (après remises, annulations d'articles)
  totalRefunded    Float? // totalRefundedSet — conservé pour transparence, jamais déduit silencieusement
  fetchedAt        DateTime  @default(now())

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  lines OrderLine[]

  @@unique([storeId, shopifyOrderId])
  @@index([storeId, createdAtShopify])
  @@map("orders")
}

model OrderLine {
  id                String  @id @default(cuid())
  orderId           String
  shopifyLineItemId String
  productId         String? // null si le produit n'existe plus / n'est pas dans le catalogue synchronisé
  variantId         String? // null si la variante n'existe plus / n'est pas dans le catalogue synchronisé
  shopifyProductId  String?
  shopifyVariantId  String?
  quantity          Int
  currentQuantity   Int // quantité après retraits/remboursements d'articles (Shopify currentQuantity)
  originalTotal     Float // originalTotalSet — avant remises
  discountedTotal   Float // discountedTotalSet — après remises de ligne et allocation des remises commande

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([orderId, shopifyLineItemId])
  @@index([productId])
  @@index([variantId])
  @@map("order_lines")
}

// Vitesse de vente : agrégat quotidien produit × jour DÉRIVÉ des lignes de
// commande stockées (Order/OrderLine) par sync/shopifyStore.ts
// (rebuildSalesSnapshots). Sémantique explicite : unitsSold = quantité
// commandée, revenue = montant de ligne après remises, commandes annulées
// EXCLUES, remboursements NON déduits (donc pas un chiffre d'affaires net).
// Jours sans vente : pas de ligne. Jamais interpolé.
model SalesSnapshot {
  id        String   @id @default(cuid())
  productId String
  date      DateTime
  unitsSold Int
  revenue   Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([productId, date])
  @@map("sales_snapshots")
}

// Agrégat quotidien MARGE (boutique entière), dérivé des mêmes OrderLine que
// SalesSnapshot — même sémantique (unités = quantité commandée, remboursements
// NON déduits, commandes annulées exclues) pour que Marge et CA restent
// comparables jour pour jour (voir rebuildMarginSnapshots, shopifyStore.ts).
// `revenue` porte le CA RÉEL du jour, toujours complet ; `margin`/`marginRate`
// ne portent que sur la part du CA où un coût est connu — `costCoverage`
// (part du CA du jour concernée, pas juste un nombre de lignes) rend cette
// limite visible plutôt que de gonfler silencieusement un taux moyen.
model MarginSnapshot {
  id           String   @id @default(cuid())
  storeId      String
  date         DateTime
  revenue      Float // CA réel du jour (REAL) — toutes lignes, comme SalesSnapshot.revenue
  totalCost    Float? // somme des coûts totaux, uniquement sur la part du CA à coût connu
  grossMargin  Float? // prix − coût fournisseur, avant transport/frais, sur la part à coût connu
  margin       Float? // marge complète (après transport + frais de paiement), sur la part à coût connu
  marginRate   Float? // margin / (revenue de la part à coût connu) — jamais / revenue total
  costCoverage Float // part du CA du jour où le coût est connu (0–1), pas une part du nombre de lignes
  orderCount   Int
  unitsSold    Int

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([storeId, date])
  @@map("margin_snapshots")
}

// ---------------------------------------------------------------------------
// TRAFIC / ACQUISITION — connecteur Google Analytics (GA4), 05/09/2026.
// Agrégats quotidiens dérivés de la Data API GA4 (runReport), jamais du
// texte brut ni des identifiants visiteurs individuels : uniquement des
// compteurs déjà agrégés par Google (aucune PII de visiteur final, comme les
// autres connecteurs — voir Order/OrderLine ci-dessus pour la même
// discipline côté e-commerce).
// ---------------------------------------------------------------------------

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  storeId     String
  date        DateTime
  sessions    Int
  activeUsers Int
  newUsers    Int
  conversions Int
  revenue     Float

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([storeId, date])
  @@map("analytics_snapshots")
}

// Même agrégat quotidien, ventilé par canal d'acquisition GA4
// (`sessionSourceMedium`, ex. "google / organic", "facebook / cpc") —
// permet de détecter un canal à fort trafic mais sans conversion.
model AnalyticsChannelSnapshot {
  id           String   @id @default(cuid())
  storeId      String
  date         DateTime
  sourceMedium String
  sessions     Int
  conversions  Int
  revenue      Float

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date, sourceMedium])
  @@index([storeId, date])
  @@map("analytics_channel_snapshots")
}

// ---------------------------------------------------------------------------
// AVIS — séparation stricte Review Intelligence (réel) / Test Mode (fictif)
// ---------------------------------------------------------------------------

model Review {
  id               String   @id @default(cuid())
  storeId          String
  productId        String?
  externalId       String // id Judge.me
  rating           Int
  title            String?
  body             String?
  authorName       String?
  verifiedPurchase Boolean  @default(false)
  publishedAt      DateTime
  fetchedAt        DateTime @default(now())

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([storeId, externalId])
  @@index([storeId])
  @@index([productId])
  @@map("reviews")
}

// Données 100% fictives — Mode Test uniquement. Jamais lues par Review
// Intelligence, jamais exportées vers une intégration réelle.
model TestReview {
  id        String   @id @default(cuid())
  storeId   String
  handle    String
  rating    Int
  title     String
  body      String
  author    String
  email     String
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("test_reviews")
}

// ---------------------------------------------------------------------------
// COÛTS / MARGE
// ---------------------------------------------------------------------------

// Une ligne par produit. Chaque champ null = hypothèse non renseignée,
// jamais inventée : le module Marge affiche alors "Non disponible" pour les
// calculs qui en dépendent, et liste précisément l'hypothèse manquante.
model CostAssumption {
  id              String   @id @default(cuid())
  storeId         String
  productId       String   @unique
  supplierCost    Float?
  shippingCost    Float?
  paymentFeesRate Float? // ex. 0.029 pour 2.9%
  otherFixedCost  Float?
  updatedAt       DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("cost_assumptions")
}

// ---------------------------------------------------------------------------
// SCORING
// ---------------------------------------------------------------------------

model ScoreSnapshot {
  id          String   @id @default(cuid())
  storeId     String
  productId   String
  score       Int // 0-100
  factorsJson String // JSON: détail explicable des facteurs (voir types/index.ts ScoreBreakdown)
  computedAt  DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, productId, computedAt])
  @@map("score_snapshots")
}

// ---------------------------------------------------------------------------
// RECOMMANDATIONS / ACTIONS / HISTORIQUE
// ---------------------------------------------------------------------------

enum RecommendationSeverity {
  URGENT
  OPPORTUNITY
  SUGGESTION
}

enum RecommendationStatus {
  OPEN
  DISMISSED
  ACTIONED
}

model Recommendation {
  id                String                 @id @default(cuid())
  storeId           String
  productId         String?
  category          String // "stock" | "margin" | "reviews" | "marketing" | "data_quality" | ...
  severity          RecommendationSeverity
  title             String
  reason            String // "Pourquoi ?"
  impact            String // "Impact potentiel ?"
  confidence        Int // 0-100, "Niveau de confiance ?"
  impactScore       Float? // impact € estimé (ex. vélocité × prix × 7j pour une rupture) — null si non calculable, jamais 0 par défaut
  actionLabel       String? // "Action proposée ?" (null si aucune action exécutable)
  actionType        String? // clé technique utilisée par le moteur d'actions
  actionPayloadJson String?
  status            RecommendationStatus   @default(OPEN)
  createdAt         DateTime               @default(now())

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  actionItems ActionItem[]

  @@index([storeId, status])
  @@index([storeId, severity])
  @@map("recommendations")
}

enum ActionSensitivity {
  SENSITIVE // prix, stock, publication, suppression, campagnes → validation humaine obligatoire
  SAFE
}

enum ActionStatus {
  PENDING_VALIDATION
  CONFIRMED
  EXECUTED
  FAILED
  CANCELLED
}

model ActionItem {
  id               String            @id @default(cuid())
  storeId          String
  recommendationId String?
  type             String // "update_price" | "update_stock" | "publish" | ...
  sensitivity      ActionSensitivity
  status           ActionStatus      @default(PENDING_VALIDATION)
  payloadJson      String // détail de l'action proposée
  resultJson       String? // résultat après exécution (ou erreur)
  createdAt        DateTime          @default(now())
  confirmedAt      DateTime?
  executedAt       DateTime?
  createdByUserId  String?

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@map("action_items")
}

model AuditLog {
  id        String   @id @default(cuid())
  storeId   String
  userId    String?
  actorType String // "user" | "system"
  event     String // ex. "sync.completed", "recommendation.created", "action.confirmed"
  message   String
  metaJson  String?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@map("audit_logs")
}

// ONDEAL AI JOB ENGINE (fondation 06/09/2026) — voir
// claude/ondeal-ai-job-engine-foundation-06-09-2026.md pour l'architecture
// complète. Trois modèles seulement, délibérément : Job (état + point de
// reprise), JobStep (journal d'ajout seul — jamais réécrit — une ligne par
// TENTATIVE d'étape, jamais mise à jour en place, pour que reprise/retry/
// audit soient la MÊME donnée plutôt que trois mécanismes séparés),
// JobArtifact (référence légère vers un fichier produit par une étape —
// capture d'écran, diff, log — jamais le contenu lui-même en base). Les
// événements de cycle de vie haut niveau (job créé/terminé-échoué) utilisent
// AuditLog, déjà existant — pas de table d'événements séparée.
enum JobStatus {
  QUEUED
  PLANNING
  RUNNING
  WAITING_RETRY
  PAUSED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum JobArtifactKind {
  SCREENSHOT
  FILE
  DIFF
  LOG
  OTHER
}

model Job {
  id               String    @id @default(cuid())
  storeId          String
  type             String // ex. "gauntlet_task" — voir src/lib/ai/jobs/types.ts pour la liste ouverte, jamais figée en enum (nouveaux types de tâche sans migration)
  status           JobStatus @default(QUEUED)
  inputJson        String // payload de départ (jamais modifié après création — la reprise ne rejoue QUE les steps, jamais l'input)
  resultJson       String? // résultat final (succès) — jamais renseigné avant status SUCCEEDED
  lastError        String? // dernière erreur lisible — pour affichage rapide sans relire les steps
  currentStepIndex Int       @default(0) // prochain index de step à exécuter — la reprise relit ce champ, jamais un recalcul déduit des steps (source unique, mise à jour atomiquement avec le step qui vient de réussir)
  attempt          Int       @default(0) // tentatives au niveau JOB (relance globale après échec définitif d'un step) — distinct de JobStep.attempt (tentatives au niveau d'UN step)
  maxAttempts      Int       @default(3) // NO BLIND LOOP — jamais un job sans plafond explicite
  cancelRequested  Boolean   @default(false) // annulation COOPÉRATIVE — le worker vérifie ce flag entre deux steps, jamais de coupure forcée d'un process externe
  createdByUserId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  startedAt        DateTime?
  finishedAt       DateTime?

  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  steps     JobStep[]
  artifacts JobArtifact[]

  @@index([storeId, status])
  @@index([status, createdAt]) // pour claimNextQueuedJob() — un seul index couvre la file par statut, tous stores confondus
  @@map("jobs")
}

model JobStep {
  id          String        @id @default(cuid())
  jobId       String
  index       Int // position dans le plan du job — 0-based, stable une fois écrit
  attempt     Int           @default(1) // 1ère tentative de CET index — une nouvelle ligne par retry, jamais une mise à jour de la précédente (voir commentaire au-dessus du bloc Job Engine)
  name        String // ex. "plan" | "execute:tool_x" | "verify" | "critic" — libre, jamais un enum figé
  status      JobStepStatus @default(PENDING)
  inputJson   String?
  outputJson  String?
  errorJson   String?
  provider    String? // "anthropic" | futur "openai"/"google" — voir src/lib/ai/providers/provider.ts ; null si le step ne fait pas d'appel modèle (ex. step purement mécanique)
  model       String?
  costUsd     Float?
  tokensIn    Int?
  tokensOut   Int?
  startedAt   DateTime?
  finishedAt  DateTime?
  heartbeatAt DateTime? // rafraîchi par le worker pendant un step long — un step RUNNING sans heartbeat récent est considéré abandonné et repris (même principe que RUNNING_GUARD_MS dans src/app/api/cron/sync/route.ts)
  createdAt   DateTime      @default(now())

  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  artifacts JobArtifact[]

  @@index([jobId, index, attempt])
  @@map("job_steps")
}

model JobArtifact {
  id         String          @id @default(cuid())
  jobId      String
  stepId     String?
  kind       JobArtifactKind
  storageRef String // chemin/URL vers le fichier réel — jamais le contenu en base (voir commentaire au-dessus du bloc Job Engine) ; stockage concret (Vercel Blob ou équivalent) non branché à cette fondation, storageRef reste un simple champ texte en attendant
  metaJson   String?
  createdAt  DateTime        @default(now())

  job  Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  step JobStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("job_artifacts")
}

// ============================================================================
// ONDEAL AI CORE — PHASE 2 : Model Router + Gauntlet, fondation (06/09/2026).
//
// ModelEvalRun/ModelEvalResult sont DÉLIBÉRÉMENT sans storeId : ce ne sont
// pas des données client (aucune donnée de boutique n'y transite — voir
// src/lib/ai/models/tasks.ts, jeu de tâches synthétique fixe), mais une
// télémétrie interne "quel modèle Anthropic répond le mieux/moins cher à un
// jeu de contraintes fixe" — comparable à un banc d'essai, pas à une donnée
// multi-tenant. Rester cohérent avec la règle d'isolation stricte du reste
// du schéma (voir en-tête de ce fichier) : c'est précisément PARCE QUE ce
// n'est pas une donnée de boutique qu'elle n'a pas à être scopée par store.
// Le déclenchement (qui a lancé le run, depuis quelle boutique) reste tracé
// dans AuditLog, pas dupliqué ici.
model ModelEvalRun {
  id          String   @id @default(cuid())
  taskSetName String // ex. "grounding_v1" — voir tasks.ts ; string libre, jamais un enum figé (même principe que Job.type)
  createdAt   DateTime @default(now())

  results ModelEvalResult[]

  @@index([taskSetName, createdAt])
  @@map("model_eval_runs")
}

model ModelEvalResult {
  id         String   @id @default(cuid())
  runId      String
  provider   String // "anthropic" — voir src/lib/ai/providers/provider.ts
  model      String
  taskName   String // voir ModelEvalTask.name dans tasks.ts
  passed     Boolean
  reason     String? // motif du échec/succès mécanique — jamais un jugement subjectif
  latencyMs  Int
  tokensIn   Int?
  tokensOut  Int?
  costUsd    Float? // voir src/lib/ai/models/cost.ts — jamais estimé, null si un ingrédient réel manque
  textSample String? // sortie brute tronquée (audit humain) — jamais le texte complet, jamais une donnée client
  createdAt  DateTime @default(now())

  run ModelEvalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([provider, model, taskName, createdAt]) // pour le Router : agréger le taux de réussite/coût par (provider, model, taskName)
  @@map("model_eval_results")
}

// ============================================================================
// ONDEAL AI CORE — PHASE 3 : SYSTEM CODER (Coder Agent + Sandbox + Browser/
// Vision), fondation (06/09/2026).
//
// CoderMission/CoderMissionStep/CoderMissionArtifact reprennent EXACTEMENT
// la mécanique Job/JobStep/JobArtifact (journal d'ajout seul — un retry crée
// une NOUVELLE ligne au même index, jamais une réécriture ; currentStepIndex
// comme SEULE source de reprise ; heartbeat pour détecter un step abandonné ;
// JobStatus/JobStepStatus/JobArtifactKind réutilisés TELS QUELS, aucun
// nouvel enum) — c'est la réutilisation explicitement demandée du Job
// Engine, pas une réinvention.
//
// Sans storeId, DÉLIBÉRÉMENT, même principe que ModelEvalRun/ModelEvalResult
// en PHASE 2 : une mission Coder Agent n'agit JAMAIS sur la donnée d'UNE
// boutique cliente, elle agit sur LE DÉPÔT OnDeal Intelligence lui-même
// (repo, tests, build, preview interne) — SYSTEM CODER = PLATFORM OWNER
// ONLY (voir src/lib/authz/capabilities.ts, capacité "SYSTEM_CODER" ;
// STORE OWNER/STORE ADMIN/AGENCY CLIENT n'y ont explicitement PAS accès,
// quel que soit leur rôle Membership). createdByUserId reste NON NULL ici
// (contrairement à Job.createdByUserId, nullable) précisément parce
// qu'aucune mission système ne doit jamais exister sans un propriétaire
// plateforme identifié — c'est le point d'audit de dernier recours.
model CoderMission {
  id               String    @id @default(cuid())
  goal             String // objectif en langage naturel — jamais modifié après création (reprise = rejoue seulement les steps, comme Job.inputJson)
  status           JobStatus @default(QUEUED)
  currentStepIndex Int       @default(0)
  attempt          Int       @default(0)
  maxAttempts      Int       @default(3) // NO BLIND LOOP — même garde que Job.maxAttempts
  cancelRequested  Boolean   @default(false)
  createdByUserId  String // PLATFORM OWNER uniquement, jamais null — voir commentaire ci-dessus
  resultJson       String?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  startedAt        DateTime?
  finishedAt       DateTime?

  steps     CoderMissionStep[]
  artifacts CoderMissionArtifact[]

  @@index([status, createdAt])
  @@map("coder_missions")
}

model CoderMissionStep {
  id          String        @id @default(cuid())
  missionId   String
  index       Int // position dans le plan — 0-based, stable une fois écrit
  attempt     Int           @default(1) // nouvelle ligne par retry, jamais une réécriture — même principe que JobStep
  name        String // ex. "inspect" | "plan" | "edit" | "typecheck" | "lint" | "test" | "build" | "preview" | "browser" | "vision" | "critic" | "fix" — libre, jamais un enum figé
  status      JobStepStatus @default(PENDING)
  inputJson   String?
  outputJson  String?
  errorJson   String?
  provider    String? // "anthropic" — null si le step est purement mécanique (ex. runTypecheck n'appelle aucun modèle)
  model       String?
  costUsd     Float? // voir src/lib/ai/models/cost.ts — jamais estimé, null si un ingrédient réel manque
  tokensIn    Int?
  tokensOut   Int?
  startedAt   DateTime?
  finishedAt  DateTime?
  heartbeatAt DateTime? // même principe que JobStep.heartbeatAt (STALE_HEARTBEAT_MS)
  createdAt   DateTime      @default(now())

  mission   CoderMission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  artifacts CoderMissionArtifact[]

  @@index([missionId, index, attempt])
  @@map("coder_mission_steps")
}

model CoderMissionArtifact {
  id         String          @id @default(cuid())
  missionId  String
  stepId     String?
  kind       JobArtifactKind // SCREENSHOT (browser/vision) | DIFF (edit) | LOG (typecheck/lint/test/build) | FILE | OTHER — même enum que Job Engine, aucun nouveau
  storageRef String // chemin/URL vers le fichier réel — jamais le contenu en base (même principe que JobArtifact.storageRef)
  metaJson   String?
  createdAt  DateTime        @default(now())

  mission CoderMission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  step    CoderMissionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([missionId])
  @@map("coder_mission_artifacts")
}

// ============================================================================
// ONDEAL AI CORE — PHASE 4 : Storefront Intelligence Engine (06/09/2026).
//
// Différence structurelle avec CoderMission (Phase 3) : une CoderMission
// exécute un plan LINÉAIRE fixe (tableau de steps, index 0..N) — adapté à
// UNE tâche de code bornée. Une StorefrontMission raisonne sur un objectif
// de TRÈS HAUT NIVEAU dont la décomposition n'est PAS connue à l'avance
// (§5 : "Représenter la mission comme un graphe persistant... doit pouvoir
// évoluer pendant la mission") — d'où un GRAPHE de nodes avec dépendances
// explicites (dependsOnJson, tableau de `key` de nodes), jamais un index
// linéaire. Le Supervisor peut ajouter de nouveaux nodes en cours de
// mission (réplanification réelle — jamais un plan figé au démarrage).
//
// Toujours PLATEFORME uniquement (jamais storeId, même précédent que
// CoderMission/ModelEvalRun) — SYSTEM_CODER gate déjà en place couvre
// aussi ce nouveau type de mission (aucune nouvelle capacité nécessaire :
// le Supervisor invoque le Coder Agent existant pour toute modification
// de code, jamais une voie d'écriture parallèle).
// ============================================================================

model StorefrontMission {
  id              String    @id @default(cuid())
  goal            String // intention de très haut niveau, langage naturel — jamais réécrite après création
  constraintsJson String? // contraintes/préférences optionnelles fournies par l'owner (budget, ton de marque, etc.)
  status          JobStatus @default(QUEUED) // PLANNING = le Supervisor construit/étend le graphe ; RUNNING = des nodes s'exécutent ; PAUSED = borne murale/budget/kill switch (résumable)
  cancelRequested Boolean   @default(false)
  createdByUserId String // PLATFORM OWNER uniquement, jamais null — même garde que CoderMission
  worldStateJson  String? // dernier WorldState construit (snapshot réel, avec provenance — voir src/lib/ai/supervisor/worldState.ts), jamais réécrit silencieusement : chaque reconstruction est un nouveau node "discover_world_state"
  resultJson      String? // rapport final structuré (§76) une fois SUCCEEDED : candidates, selection reason, judge verdict, coûts, limitations connues
  lastError       String?
  totalCostUsd    Float? // somme réelle des coûts de nodes — jamais estimée globalement, recalculée depuis les nodes
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  // PHASE 5 (06/09/2026) — AI Lab Ultimate : ces 5 champs sont l'objet du
  // "SPECIALIST CONTRACT" au niveau mission (Owner Sovereignty §5/§12) —
  // fixés à la création, JAMAIS modifiables par le Supervisor/un
  // spécialiste lui-même (aucune fonction d'écriture n'existe côté
  // supervisor/*.ts pour ces colonnes — seule graphStore.ts, appelé
  // uniquement par les routes API Owner, les écrit).
  environment   String  @default("SANDBOX") // SANDBOX | PREVIEW | PRODUCTION — SANDBOX par défaut, PRODUCTION jamais choisi implicitement
  autonomyLevel String  @default("ASSIST") // ASSIST | AUTONOMOUS | DEEP | ULTIMATE — ne change JAMAIS le périmètre de capacités, seulement la profondeur de raisonnement/vérification dans ce périmètre (voir policy/engine.ts)
  hardBudgetUsd Float? // plafond dur réel (§"Hard Budget") — STOP/PAUSE si dépassé, jamais un dépassement silencieux (graphRunner.ts)
  storeId       String? // optionnel : boutique RÉELLE ciblée si la mission utilise Store Data/Shopify/GA4/Judge.me/CJ — null pour une mission pure code/recherche qui ne porte sur aucune boutique précise
  forcedModel   String? // §"Model Console" FORCE MODEL — Owner uniquement, jamais auto-défini par le Supervisor

  // §11 "ADD INSTRUCTION DURING MISSION" (mandat complétion, 06/09/2026) —
  // pendingInstruction est consommé (remis à null) au TOUT DÉBUT de
  // l'itération de boucle suivante (graphRunner.ts), qui l'injecte dans le
  // WorldState comme un fait OWNER_INSTRUCTION et déclenche un re-planning
  // réel — jamais un simple log ignoré. instructionsJson conserve
  // l'historique complet (jamais réécrit), pour l'audit et l'UI Timeline.
  pendingInstruction String?
  instructionsJson   String?

  store       Store?                      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  nodes       StorefrontMissionNode[]
  artifacts   StorefrontMissionArtifact[]
  attachments AiLabAttachment[]
  auditLogs   AiLabAuditLog[]

  @@index([status, createdAt])
  @@index([storeId])
  @@map("storefront_missions")
}

// ============================================================================
// PHASE 5 (06/09/2026) — AI Lab Ultimate : File Intelligence (pièces jointes).
//
// Standalone à la création (missionId null tant que l'owner n'a pas encore
// créé/choisi la mission qui l'utilisera — upload puis attache, jamais
// l'inverse) — voir attachments/store.ts. Le contenu RÉEL du fichier reste
// sur disque (storageRef, même principe que CoderMissionArtifact.storageRef,
// JAMAIS en base) ; seul le texte EXTRAIT (parsers réels : pdf-parse/
// mammoth/xlsx/csv, jamais fabriqué) est mis en base, tronqué si nécessaire.
// ============================================================================
model AiLabAttachment {
  id               String   @id @default(cuid())
  missionId        String?
  filename         String
  mimeType         String
  sizeBytes        Int
  storageRef       String // chemin réel sur disque du fichier original — jamais le contenu binaire en base
  kind             String // "PDF" | "DOCX" | "XLSX" | "CSV" | "JSON" | "TXT" | "MD" | "CODE" | "IMAGE" | "UNKNOWN" — dérivé du mimeType/extension réel, jamais supposé
  parseStatus      String   @default("PENDING") // PENDING | PARSED | FAILED | UNSUPPORTED — UNSUPPORTED si aucun parser réel n'existe pour ce type (jamais un "parsed" fictif)
  parseError       String?
  extractedText    String? // texte réellement extrait (tronqué à une taille raisonnable) — null si parseStatus != PARSED
  uploadedByUserId String
  createdAt        DateTime @default(now())

  mission StorefrontMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([missionId])
  @@map("ai_lab_attachments")
}

// ============================================================================
// PHASE 5 (06/09/2026) — Owner Sovereignty : Policy Engine + Kill Switch.
//
// Singleton RÉEL (une seule ligne, id fixe "singleton") — jamais un fichier
// de config statique : l'Owner Control Center DOIT pouvoir le modifier au
// runtime et l'effet doit être immédiat (§17 "NO FAKE CONTROL" : un bouton
// Owner doit réellement changer ce que lit le runtime). Écrit UNIQUEMENT
// par les routes API sous requireCapability("SYSTEM_CODER") (policy/engine.ts
// et supervisor/*.ts ne font que LIRE cette table, jamais l'écrire — §3
// "AI DOES NOT CONTROL ITS OWN POWER").
// ============================================================================
model SystemPolicy {
  id                       String   @id @default("singleton")
  killSwitchEngaged        Boolean  @default(false) // §6/§17 : si true, AUCUNE mission ne progresse (vérifié à chaque itération de boucle, graphRunner.ts) — arrêt réel, pas décoratif
  killSwitchReason         String?
  defaultAutonomyLevel     String   @default("ASSIST")
  maxHardBudgetUsdGlobal   Float    @default(20) // plafond ABSOLU qu'AUCUNE mission ne peut dépasser même si son propre hardBudgetUsd est plus élevé — filet de sécurité Owner, jamais contournable par le Supervisor
  productionEffectsAllowed Boolean  @default(false) // §8 : effecteurs de production toujours DENY tant que false — bascule Owner explicite, jamais activée par défaut
  updatedByUserId          String?
  updatedAt                DateTime @updatedAt

  @@map("system_policy")
}

// ============================================================================
// PHASE 5 (06/09/2026) — Owner Sovereignty §13 "AUDIT EVERYTHING IMPORTANT".
//
// Append-only (aucune fonction UPDATE/DELETE côté code — voir audit.ts) —
// une ligne par décision de policy ET par exécution de node/tool/connector
// RÉELLEMENT tentée (jamais seulement les succès). Ne loggue JAMAIS une
// valeur de secret (§14 : "secret exposure" interdit même à l'Owner).
// ============================================================================
/**
 * ONDEAL AI CORE — §14/§15 "Dynamic Agent Registry / Owner Agent Control"
 * (06/09/2026), clôture réelle. Une ligne PAR RÔLE de spécialiste (voir
 * AVAILABLE_ROLES, graphRunner.ts) — absente = comportement par défaut
 * (activé). `enabled=false` a un effet RUNTIME RÉEL : le rôle est retiré des
 * rôles disponibles proposés au planner (graphRunner.ts) ET dispatchSpecialist
 * refuse de l'exécuter même si un plan existant (créé avant la désactivation)
 * le référence encore — défense en profondeur, jamais un simple filtre côté
 * UI. Le forçage de provider/modèle PAR RÔLE n'existe volontairement PAS ici
 * (§1 "NO CAPABILITY THEATER") : la sélection provider/modèle est
 * aujourd'hui globale à la mission (ModelConfig/FailoverProvider), un champ
 * "preferredModel" sur ce modèle n'aurait aucun effecteur réel tant que
 * catalogue.ts/specialists.ts ne prennent pas un provider par rôle — jamais
 * un contrôle qui prétend un effet qu'il n'a pas.
 */
model AgentRoleConfig {
  role            String   @id // ex. "researcher", "coder_implementation" — même chaîne que StorefrontMissionNode.role
  enabled         Boolean  @default(true)
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("agent_role_configs")
}

model AiLabAuditLog {
  id           String   @id @default(cuid())
  missionId    String?
  nodeKey      String?
  actorUserId  String? // qui a déclenché (Owner) — null pour une action purement automatique du Supervisor à l'intérieur d'une mission déjà autorisée
  agentRole    String? // rôle de spécialiste (§"WHICH AGENT")
  provider     String?
  model        String?
  toolId       String? // id du Tool Registry invoqué, si applicable
  connectorId  String? // id du Connector Registry invoqué, si applicable
  storeId      String?
  action       String // ex. "node_execute" | "policy_decision" | "kill_switch_toggle" | "mission_create" | "mission_cancel"
  decision     String? // ALLOW_AUTO | REQUIRE_APPROVAL | DENY — présent uniquement pour action="policy_decision"
  riskClass    String?
  reason       String
  costUsd      Float?
  resultStatus String? // "SUCCESS" | "FAILURE" | "DENIED" — jamais absent pour une action terminée
  createdAt    DateTime @default(now())

  mission StorefrontMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([missionId])
  @@index([createdAt])
  @@map("ai_lab_audit_logs")
}

model StorefrontMissionNode {
  id            String        @id @default(cuid())
  missionId     String
  key           String // identifiant stable du node au sein de la mission (ex. "commerce_analyst", "direction_b_critic") — jamais réutilisé pour un autre rôle une fois créé
  role          String // rôle du spécialiste ou de l'étape mécanique invoquée — libre, jamais un enum figé (même principe que CoderMissionStep.name) : le catalogue de spécialistes (§6) n'est PAS fermé
  dependsOnJson String? // tableau JSON des `key` de nodes requis SUCCEEDED (ou SKIPPED — branche élaguée) avant exécution ; [] ou null = exécutable dès que la mission tourne
  status        JobStepStatus @default(PENDING) // PENDING → RUNNING → SUCCEEDED/FAILED ; SKIPPED = branche PRUNE par le Supervisor (§11), jamais supprimée (traçabilité)
  attempt       Int           @default(1) // nouvelle ligne par retry (même principe que CoderMissionStep.attempt), jamais une réécriture
  inputJson     String? // contrat Specialist reçu (§7) : objective, context, allowed tools, budget, expected schema
  outputJson    String? // sortie structurée retournée : findings, evidence, uncertainties, recommendations, confidence, artifacts (§7)
  confidence    Float? // 0-1, auto-rapportée par le spécialiste — jamais une certitude fabriquée quand la donnée manque (§15)
  errorJson     String?
  provider      String?
  model         String?
  costUsd       Float?
  tokensIn      Int?
  tokensOut     Int?
  startedAt     DateTime?
  finishedAt    DateTime?
  heartbeatAt   DateTime? // même principe que CoderMissionStep.heartbeatAt (détection de node "stale")
  createdAt     DateTime      @default(now())

  mission   StorefrontMission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  artifacts StorefrontMissionArtifact[]

  @@unique([missionId, key])
  @@index([missionId, status])
  @@map("storefront_mission_nodes")
}

model StorefrontMissionArtifact {
  id         String          @id @default(cuid())
  missionId  String
  nodeId     String?
  kind       JobArtifactKind // SCREENSHOT | DIFF | LOG | FILE | OTHER — même enum réutilisé, aucun nouveau
  storageRef String // chemin réel sur disque — jamais le contenu en base
  metaJson   String?
  createdAt  DateTime        @default(now())

  mission StorefrontMission      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  node    StorefrontMissionNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([missionId])
  @@map("storefront_mission_artifacts")
}

// ============================================================================
// ONDEAL AI CORE — ULTIMATE COMPLETION MANDATE (06/09/2026, session 2).
//
// Additions purement additives — aucune colonne existante retirée/renommée,
// aucune donnée touchée. Chaque nouveau modèle referme un écart précis signalé
// par le mandat, en réutilisant l'existant (Job Engine, crypto.ts, Control
// Plane) plutôt qu'en le dupliquant — voir le rapport de session pour le
// détail modèle par modèle.
// ============================================================================

// §33/§45 — Connecteurs de PLATEFORME (Owner, jamais scopés par storeId —
// distinct d'Integration qui est TOUJOURS par boutique/Merchant Plane).
// Un connecteur ici sert les AGENTS d'AI Lab eux-mêmes (ex. GitHub sur le
// dépôt ondeal-intelligence lui-même), jamais une donnée d'un marchand.
// Une seule ligne par provider (pas de storeId) — Owner uniquement
// (SYSTEM_CODER, capabilities.ts). encryptedCredentials réutilise
// EXACTEMENT src/lib/crypto.ts (AES-256-GCM), jamais un second mécanisme.
model PlatformIntegration {
  id                   String    @id @default(cuid())
  provider             String    @unique // "github" — string libre, comme Job.type (nouveau connecteur = nouvelle ligne, jamais une migration)
  status               String    @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTED | ERROR — calculé depuis le dernier health check RÉEL, jamais déduit de la présence d'un secret
  encryptedCredentials String?
  scopesJson           String? // scopes RÉELLEMENT accordés par le token (dérivés d'un appel API réel à la connexion, jamais supposés)
  connectedByUserId    String?
  lastHealthCheckAt    DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("platform_integrations")
}

// §16 — Model Console complet : Owner peut ENABLE/DISABLE/SET DEFAULT/FORCE
// FOR TEST/SET MAX COST. Une ligne par (provider, model) UNIQUEMENT quand
// l'Owner a changé quelque chose par rapport au comportement par défaut du
// Router (chooseModel) — l'ABSENCE de ligne signifie "comportement par
// défaut inchangé", jamais un état ambigu. router.ts/dispatch LISENT cette
// table ; AUCUN fichier supervisor/*.ts n'y écrit (même principe que
// SystemPolicy : l'IA ne contrôle jamais son propre pouvoir).
model ModelConfig {
  id                String    @id @default(cuid())
  provider          String
  model             String
  enabled           Boolean   @default(true) // false = DISABLED, le Router ne le choisit jamais, un appel explicite (forceModel) le refuse aussi
  isDefault         Boolean   @default(false) // au plus une ligne true à la fois (imposé en code, jamais en contrainte DB — voir setModelDefault())
  forceForTestUntil DateTime? // si dans le futur, CE modèle est utilisé pour TOUTE nouvelle mission quel que soit le Router — expire seul, jamais une bascule permanente oubliée
  maxCostPerCallUsd Float? // plafond dur par appel — un appel qui le dépasserait est refusé avant l'exécution, jamais après coup
  providerPriority  Int       @default(0) // ordre de préférence pour le failover (§24) — plus petit = essayé en premier
  updatedByUserId   String?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())

  @@unique([provider, model])
  @@map("model_configs")
}

// §9/§57-60 — Memory Architecture, gouvernée et tenant-isolée. `storeId`
// nullable UNIQUEMENT pour la mémoire de plateforme (jamais business d'un
// marchand — voir §23 tenant isolation, audit architecture frontier) ; toute
// mémoire liée à UNE boutique DOIT porter un storeId réel, jamais null.
// "aucune mémoire n'est une source de vérité" (principe déjà écrit dans
// assistant.ts) : une lecture mémoire concernant prix/stock/marge doit
// TOUJOURS être réconciliée contre le moteur déterministe avant affichage —
// contrat documenté ici, appliqué côté appelant (specialists.ts).
model MemoryRecord {
  id         String    @id @default(cuid())
  scope      String // WORKING | EPISODIC | BRAND | DESIGN | ENGINEERING | FAILURE | OUTCOME | MODEL_PERFORMANCE
  storeId    String? // null = mémoire de plateforme (jamais une donnée business marchand sans storeId)
  missionId  String? // provenance : mission d'origine, si applicable
  content    String // texte de la mémoire elle-même
  metaJson   String? // structuré : ex. {agentCombination, modelTaskPair, tool, strategy} pour SUCCESS/FAILURE memory (§59/§60)
  confidence Float     @default(1) // 0-1, jamais fabriquée à 1 par défaut sans justification — voir écrivains (specialists.ts)
  sourceKind String // "mission_result" | "owner_note" | "job_result" | "critic_verdict" | "judge_verdict"
  createdAt  DateTime  @default(now())
  expiresAt  DateTime? // politique de rétention explicite — null = pas d'expiration automatique (à revoir après relecture RGPD, voir audit conformité 05/09/2026)

  @@index([scope, storeId])
  @@index([missionId])
  @@map("memory_records")
}

// §51/§52 — Experiment Mode : compare deux configurations (modèle, agent,
// prompt ou stratégie) sur LE MÊME objectif réel, alimente le Gauntlet
// (ModelEvalRun réutilisé quand la comparaison est purement modèle ;
// ExperimentRun couvre le cas général — objectif de mission réel, pas
// seulement les tâches fixes grounding_v1).
model ExperimentRun {
  id              String    @id @default(cuid())
  objective       String
  dimension       String // "MODEL" | "PROMPT" | "STRATEGY" | "AGENT"
  createdByUserId String
  status          String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  winnerVariantId String?
  createdAt       DateTime  @default(now())
  finishedAt      DateTime?

  variants ExperimentVariant[]

  @@map("experiment_runs")
}

model ExperimentVariant {
  id            String   @id @default(cuid())
  experimentId  String
  label         String // "A" | "B" | ...
  provider      String?
  model         String?
  promptVariant String?
  outputText    String?
  costUsd       Float?
  latencyMs     Int?
  score         Float? // jugé par Critic/Judge indépendant (§53), jamais par le variant lui-même
  scoreReason   String?
  createdAt     DateTime @default(now())

  experiment ExperimentRun @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@map("experiment_variants")
}

// §61-65 "System Evolution Console" (06/09/2026) — pipeline d'auto-amélioration
// RÉEL, jamais un badge décoratif : une hypothèse (repérée mécaniquement dans
// les vraies statistiques du système, ou écrite par l'Owner) devient une VRAIE
// CoderMission (Phase 3, réutilisée sans modification) qui édite le code,
// compile, teste, construit — puis l'Owner RELIT le résultat réel avant toute
// décision. L'IA ne peut structurellement PAS s'auto-accorder le droit de
// livrer : `shippedPrUrl` n'est écrit QUE par evolution/ship.ts, appelé
// UNIQUEMENT depuis une route protégée par requireCapabilityWithStepUp — même
// principe que SystemPolicy (§"Owner Sovereignty").
model EvolutionProposal {
  id String @id @default(cuid())

  // "SYSTEM_ANALYSIS" = détecté mécaniquement (AgentRegistry/Memory réels,
  // jamais un signal inventé) ; "OWNER" = écrit directement par l'Owner.
  source     String
  hypothesis String // ce qui est proposé et pourquoi — texte réel, jamais un placeholder
  targetArea String // ex. "supervisor", "connectors", "policy" — libre, jamais un enum figé prématurément

  status String @default("PROPOSED")
  // PROPOSED → MISSION_LAUNCHED → AWAITING_OWNER_REVIEW → (APPROVED | REJECTED) → (SHIPPED si APPROVED et livré)

  coderMissionId String? @unique // CoderMission RÉELLE (Phase 3) qui implémente l'hypothèse — jamais un lien vers une exécution fictive

  reviewedByUserId String?
  reviewNote       String?
  reviewedAt       DateTime?

  shippedPrUrl    String? // renseigné UNIQUEMENT par evolution/ship.ts après une VRAIE création de PR GitHub
  shippedBranch   String?
  shippedAt       DateTime?

  createdByUserId String? // Owner qui a écrit l'hypothèse (source=OWNER) — null si source=SYSTEM_ANALYSIS (aucun utilisateur humain à l'origine du texte)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@map("evolution_proposals")
}

// ============================================================================
// OWNER STRONG AUTHENTICATION (06/09/2026, "DELIVERY CONDITION — OWNER
// IDENTITY"). Couche SÉPARÉE et ADDITIONNELLE au-dessus de la session
// applicative normale (User/AUTH_SECRET JWT, inchangée, sert toujours à
// authentifier N'IMPORTE QUEL utilisateur, marchand y compris) — jamais un
// remplacement. Un utilisateur peut être PLATFORM_OWNER_USER_IDS ET pourtant
// n'avoir AUCUNE PlatformOwnerSession valide : dans ce cas /ai-lab et le
// Control Plane restent inaccessibles tant qu'une cérémonie WebAuthn réelle
// n'a pas eu lieu — "PLATFORM OWNER identity ne repose JAMAIS seulement sur
// email/password/env var/rôle" est donc vrai au niveau du CODE, pas
// seulement de la documentation : requirePlatformOwnerPage()/
// requireCapability() vérifient les DEUX (voir authz/ownerSession.ts).
// ============================================================================

// Une clé WebAuthn/FIDO2 RÉELLE (aucune biométrie/clé privée ne transite ni
// n'est stockée ici — seule la clé PUBLIQUE + un compteur anti-clonage, le
// principe même de FIDO2). `credentialId` est l'identifiant opaque renvoyé
// par l'authenticator, jamais fabriqué côté serveur.
model PlatformOwnerCredential {
  id           String    @id @default(cuid())
  userId       String // doit être dans PLATFORM_OWNER_USER_IDS au moment de l'enregistrement — vérifié à l'écriture, jamais supposé à la lecture
  credentialId String    @unique // base64url, tel que renvoyé par l'authenticator
  publicKey    Bytes // clé publique COSE, jamais une clé privée
  counter      BigInt    @default(0) // anti-clonage FIDO2 : doit strictement augmenter à chaque authentification, sinon clé révoquée (voir ownerSession.ts)
  transports   String? // JSON des transports déclarés (usb/ble/nfc/internal)
  deviceLabel  String // libellé humain choisi à l'enregistrement (ex. "MacBook — Touch ID")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  @@index([userId])
  @@map("platform_owner_credentials")
}

// Codes de récupération à usage unique (second facteur de recours si
// l'authenticator est perdu) — hashés (jamais en clair), générés UNE SEULE
// FOIS à l'enregistrement de la première clé, affichés une seule fois au
// Owner. Consommer un code force l'enregistrement immédiat d'une nouvelle
// clé avant tout accès Control Plane (voir owner/recovery/consume route).
model PlatformOwnerRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // sha256 du code, jamais le code lui-même
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("platform_owner_recovery_codes")
}

// Session Owner SERVER-SIDE (contrairement à la session applicative
// normale, un JWT stateless sans registre) — c'est ce qui rend la
// révocation RÉELLE possible : révoquer = `revokedAt` non-null, vérifié à
// CHAQUE accès Control Plane (jamais un simple TTL qui expire seul).
// `assuranceLevel` distingue une session juste ouverte par passkey
// (L2_PASSKEY, accès /ai-lab en lecture + actions non sensibles) d'une
// session RÉCEMMENT réélevée par une seconde cérémonie WebAuthn
// (L3_STEP_UP, `stepUpExpiresAt`) — requise avant toute action sensible
// (kill switch, policy, connecteurs, force model, dispatch production) —
// voir requireStepUp(), ownerSession.ts.
model PlatformOwnerSession {
  id              String    @id @default(cuid())
  userId          String
  assuranceLevel  String    @default("L2_PASSKEY") // L2_PASSKEY | L3_STEP_UP
  stepUpExpiresAt DateTime? // L3_STEP_UP expire seul après une courte fenêtre (voir ownerSession.ts) — jamais une élévation permanente
  credentialId    String // quelle clé a ouvert CETTE session — traçabilité (§AUDIT)
  userAgent       String?
  ipHash          String? // haché (jamais l'IP en clair) — suffisant pour distinguer les sessions dans l'UI "Sessions actives", jamais pour de la géolocalisation
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  revokedAt       DateTime?
  revokedReason   String?

  @@index([userId, revokedAt])
  @@map("platform_owner_sessions")
}

// Challenges WebAuthn éphémères (registration ET authentication) — une
// ligne par cérémonie en cours, supprimée après vérification ou expiration
// (jamais réutilisable, anti-replay — le protocole FIDO2 lui-même l'exige).
model PlatformOwnerWebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String
  challenge String
  kind      String // "REGISTRATION" | "AUTHENTICATION" | "STEP_UP"
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, kind])
  @@map("platform_owner_webauthn_challenges")
}
